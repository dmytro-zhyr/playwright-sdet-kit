{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@api/*": ["./api/*"],
      "@deployments/*": ["./deployments/*"],
      "@data/*": ["./data/*"],
      "@po/*": ["./po/*"],
      "@schemas/*": ["./schemas/*"],
      "@assertions/*": ["./assertions/*"],
      "@pipeline/*": ["./pipeline/*"],
      "@report/*": ["./report/*"],
      "@fixtures": ["./fixtures.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
