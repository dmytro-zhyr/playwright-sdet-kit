{
  "name": "playwright-sdet-kit",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test automation framework with a BA-QA-TA agent chain on top",
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:contract": "playwright test --project=contract --workers=1",
    "test:defects": "playwright test --project=defects",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/rosie": "^0.0.45",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "dotenv": "^17.4.2",
    "rosie": "^2.1.1",
    "zod": "^4.4.3"
  },
  "private": true
}
