# Named deployments, one variable each. Every one has a working default, so the repository runs
# with no .env at all; copy this file to .env only when you want to point a name somewhere else.
#
# A test does not spell a URL and does not inherit one by accident: it asks for a deployment by
# name — `await deployment('conduit-gate')` — and `deployments/registry.ts` is the one place a name
# becomes a URL. The names below are that registry; a name it does not know is an error that
# lists these, never a silent fall back to a default.
#
# A deployment has up to two surfaces, and each gets its own variable: the API, and the browser
# UI in front of it. They are separate hosts, not one address with a suffix — see conduit-gate,
# which has an API and no UI at all.

# ---------------------------------------------------------------------------------------------
# conduit-gate — the deployment the `contract` gate is measured against, and the default target
# of anything that talks to a network without naming a deployment.
#
# It conforms broadly. D-6 to D-9 in spec/FINDINGS.md are its defects, and each one has a test in
# tests/defects/ that names `conduit-gate` explicitly.
#
# ⛔ It has NO browser UI — https://realworld.habsida.net/ answers 404, checked 30 August 2026.
# There is no CONDUIT_UI_URL to uncomment: the registry records the absence as a fact, and asking
# this deployment for a UI throws rather than handing back the API URL below.
# ---------------------------------------------------------------------------------------------

CONDUIT_API_URL=https://realworld.habsida.net/api

# ---------------------------------------------------------------------------------------------
# conduit-unsound — writes invisible to everyone but their author, uniqueness enforced nowhere,
# and a token that stops identifying its own user under load. D-1 to D-5 in spec/FINDINGS.md.
#
# It is also the default target of the `defects` project, which is why the variable is named for
# that suite rather than for the deployment.
#
# ⛔ Do NOT point this at a conforming target. The tests that name it assert the specification, so
# a healthy target turns them green — and green in that suite is supposed to mean the defect was
# fixed. A pass bought by moving the target is a lie told by a passing test.
# ---------------------------------------------------------------------------------------------

CONDUIT_DEFECTS_API_URL=https://api.realworld.show/api

# Its UI. Registered so a defect can be reproduced through a browser, not so browser tests can be
# measured here: D-5 hides a write from everyone but its author, so a UI test that publishes an
# article and then looks for it in the global feed fails on this deployment for a reason that has
# nothing to do with the page.

# CONDUIT_DEFECTS_UI_URL=https://demo.realworld.show

# ---------------------------------------------------------------------------------------------
# conduit-overstrict — conforms, but rejects a username longer than 20 characters, a limit the
# specification never states. A target that validates more than the contract makes a conformance
# suite report failures that are not failures, which is why it is not the API gate.
#
# It is, however, the UI gate — reached by elimination: conduit-gate has no UI, and
# conduit-unsound would colour browser tests with its own backend defects. The 20-character
# ceiling is never approached from a browser test, because data/userFactory.ts emits `qa_` plus
# 10 characters, 13 in all.
# ---------------------------------------------------------------------------------------------

# CONDUIT_OVERSTRICT_API_URL=https://conduit-api.bondaracademy.com/api
# CONDUIT_OVERSTRICT_UI_URL=https://conduit.bondaracademy.com

# ---------------------------------------------------------------------------------------------
# Switching the gate between the three is how their behaviour gets compared: point
# CONDUIT_API_URL at another one of them, run `npm run test:contract`, and read the difference.
# ---------------------------------------------------------------------------------------------
