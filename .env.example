# Two targets, two variables. Both have working defaults, so the repository runs with no .env
# at all; copy this file to .env only when you want to point somewhere else.

# ---------------------------------------------------------------------------------------------
# CONDUIT_API_URL — the target of the `contract` gate (and of anything else that talks to a
# network). Three hosted Conduit deployments were live on 24 August 2026, and they do not behave
# the same way. Switching the gate between them is how you compare their behaviour: uncomment
# one line, run `npm run test:contract`, and read the difference.
# ---------------------------------------------------------------------------------------------

# conforms — the default gate target
CONDUIT_API_URL=https://realworld.habsida.net/api

# writes invisible to others, duplicate emails accepted, token confusion under load
# CONDUIT_API_URL=https://api.realworld.show/api

# conforms, but enforces a 20-character username limit the specification never states
# CONDUIT_API_URL=https://conduit-api.bondaracademy.com/api

# ---------------------------------------------------------------------------------------------
# CONDUIT_DEFECTS_API_URL — the target of the `defects` suite, pinned to the deployment whose
# defects those tests document. See spec/FINDINGS.md, D-1 to D-5.
#
# ⛔ Do NOT point this at a conforming target. Those tests assert the specification, so a healthy
# target turns them green — and green in that suite is supposed to mean the defect was fixed.
# A pass bought by moving the target is a lie told by a passing test.
# ---------------------------------------------------------------------------------------------

CONDUIT_DEFECTS_API_URL=https://api.realworld.show/api
